# Google Gemini API Key (Required for live AI tutor generation)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# MongoDB Atlas Connection URI (Required for user authentication & cloud project sync)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/socrates?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for signing session authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# ==============================================================================
# Email Verification Options (Choose Option A or Option B)
# ==============================================================================
# Option A (Recommended - Zero Google 2FA or SMS required):
# Sign up in 1 minute at https://resend.com (free 3,000 emails/month) and copy your API key:
RESEND_API_KEY=
# RESEND_FROM="Socrates AI <onboarding@resend.dev>"

# Option B (Standard SMTP):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Socrates AI Tutor" <noreply@socrates.ai>
